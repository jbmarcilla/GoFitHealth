# Supabase — Settings > API (Data API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Google OAuth — Se configura en Supabase, NO aquí
# 1. Ve a Google Cloud Console > APIs & Services > Credentials
# 2. Crea un OAuth 2.0 Client ID (tipo: Web application)
# 3. En "Authorized redirect URIs" agrega:
#    https://tu-proyecto.supabase.co/auth/v1/callback
# 4. Copia el Client ID y Client Secret
# 5. Ve a Supabase Dashboard > Authentication > Providers > Google
# 6. Pega el Client ID y Client Secret ahí
# 7. Listo — no necesitas poner nada en este .env para Google

NUXT_PUBLIC_SITE_URL=http://localhost:3000
